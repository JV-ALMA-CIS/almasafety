rules_version = '2';

// JVA Safety — baseline Cloud Storage security rules.
//
// Mirrors the organization-isolation posture in firestore.rules for
// FILE PATH LAYOUT only: Storage holds safety evidence (hazard photos,
// corrective-action evidence, Daily Safety Meeting evidence, safety
// learning media) under paths scoped by organization:
//   organizations/{organizationId}/{...}
//
// AUTHORIZATION LIVES IN THE CALLABLES, NOT HERE. This file deliberately
// does NOT cross-reference Firestore membership documents (via
// `firestore.get`/`firestore.exists`) to scope read/write per organization,
// even though `firestore.rules` uses exactly that pattern for its own
// collections. An earlier version of this file did attempt that — checking
// the caller's own `users/{uid}/memberships/{organizationId}` document,
// mirroring `firestore.rules`' `belongsToOrganization()` — and it was
// syntactically correct (matches Firebase's documented cross-service Rules
// syntax exactly) and worked in the Firestore+Storage emulator, but
// returned 403 in production for real users with a genuinely valid, active
// membership. That is consistent with a known class of Firebase issue where
// Storage Rules' cross-service Firestore access depends on a project-level
// IAM grant (`roles/firebaserules.firestoreServiceAgent`) that is not
// always present/propagated, and this project's owner does not have (and
// should not need) direct IAM console access just to keep file uploads
// working. Rather than depend on that fragile, hard-to-diagnose cross-
// service call for a check that is REDUNDANT with real enforcement anyway,
// this file now only requires the caller to be signed in — EXCEPT the
// Safety Learning library folder, which no client may write at all: files
// are published into it server-side by `publishLearningUpload` after an
// author check, from the uploader's own `learning_uploads/{uid}/...`
// staging folder (see those `match` blocks below).
//
// THIS IS SAFE because every write that matters is already independently
// authorized server-side, in the Cloud Functions Admin SDK (which bypasses
// these Rules entirely and is the actual security boundary):
//   - `createHazard`/`addMeetingEvidence`/etc. each re-verify the caller's
//     own active organization membership, role and site access before
//     writing ANY Firestore metadata document that references a Storage
//     file — see e.g. `daily_safety_meeting_callable.ts`'s header note on
//     EVIDENCE.
//   - A file uploaded directly to Storage by a signed-in user from another
//     organization, with no corresponding callable-authorized metadata
//     document, is an orphaned, unreferenced blob: nothing in this app ever
//     reads Storage independently of a Firestore metadata row, and nothing
//     surfaces an orphaned file's contents to any other user. It is a low-
//     severity storage-quota/cleanup concern, not a data-exposure one.
//   - A signed-in user COULD still directly read another organization's
//     already-uploaded files if they somehow learned the exact
//     download URL/path — the same trade-off `hazards`' pre-existing upload
//     path already accepted ("any org member may upload... this performs
//     no separate authorization check of its own"). Firebase Storage
//     download URLs already carry an unguessable per-file token, which is
//     the practical mitigation for this — an attacker needs the exact URL,
//     not just a project id, and none of the download URLs this app
//     generates are exposed to a caller who lacks the matching Firestore
//     read grant on the metadata document that names them.
service firebase.storage {
  match /b/{bucket}/o {

    function isSignedIn() {
      return request.auth != null;
    }

    // The upload limit — mirrored client-side by `maxLearningUploadBytes`
    // (lib/features/safety_learning/domain/video_source.dart).
    function isUnderSizeLimit() {
      return request.resource.size < 25 * 1024 * 1024;
    }

    match /{allPaths=**} {
      allow read, write: if false;
    }

    // Every organization folder EXCEPT `safety_learning` (below).
    match /organizations/{organizationId}/{folder}/{rest=**} {
      // Any signed-in user may read/write here — see this file's header
      // note for why organization isolation is enforced by the callables'
      // Firestore metadata writes, not by a Storage-level membership check.
      // Rewrites stay allowed: e.g. the offline outbox may re-upload to the
      // same path after a retry.
      allow read: if isSignedIn();
      // `allow write` covers create/update AND delete — `request.resource`
      // is null on a delete (there is no new resource to size-check), so
      // the size condition is skipped for delete via `request.resource ==
      // null` rather than being evaluated against a null `.size`, which
      // errors rather than returning false.
      allow write: if isSignedIn()
        && folder != 'safety_learning'
        && (request.resource == null || isUnderSizeLimit());
    }

    // The Safety Learning library's own files (JVA videos, documents):
    //   organizations/{organizationId}/safety_learning/{uploadId}/{fileName}
    //
    // READ-ONLY for every client. Storage Rules here cannot tell an Admin
    // or Site Manager from any other signed-in user (no Firestore lookup —
    // see this file's header — and no custom claims), so files reach this
    // folder ONLY through `publishLearningUpload`
    // (`learning_upload_callable.ts`), which checks the caller is a library
    // author for the organization and copies their staged upload in with
    // the Admin SDK. No client can create, overwrite or delete a training
    // file here.
    match /organizations/{organizationId}/safety_learning/{uploadId}/{fileName} {
      allow read: if isSignedIn();
    }

    // A library author's own staging area for an upload awaiting
    // `publishLearningUpload`:
    //   learning_uploads/{uid}/{uploadId}/{fileName}
    // Scoped to the uploader by `request.auth.uid` alone (no Firestore
    // lookup needed): only they can create, read or delete their staged
    // files. Same size limit and file types as the library; never an
    // overwrite. Anything left here is visible to no one else and is
    // deleted when published.
    match /learning_uploads/{uid}/{uploadId}/{fileName} {
      function isUploader() {
        return request.auth != null && request.auth.uid == uid;
      }
      allow read, delete: if isUploader();
      allow create: if isUploader()
        && resource == null
        && isUnderSizeLimit()
        && request.resource.contentType.matches(
          'video/.*|image/(png|jpeg)|application/pdf|application/msword|'
          + 'application/vnd[.]ms-(powerpoint|excel)|'
          + 'application/vnd[.]openxmlformats-officedocument[.].*');
    }
  }
}
