rules_version = '2';

// JVA Safety — Firestore security rules.
//
// THESE RULES ARE THE AUTHORIZATION BOUNDARY. The Flutter client's
// SessionController checks are usability only; a modified client must gain
// nothing by bypassing them.
//
// Authentication model: SELF-REGISTRATION -> PENDING -> ADMIN APPROVAL ->
// ACTIVE.
//
// User profiles live at the TOP LEVEL:
//   users/{uid}
//     { uid, name, email, phone, accountStatus, platformRole?,
//       createdAt, updatedAt }
//
// MULTI-ORGANIZATION MEMBERSHIP MODEL. A user's relationship to any given
// organization — role, workerType, trade, siteIds, supervisorUid, and a
// per-org status — lives in a subcollection, not on the top-level profile:
//
//   users/{uid}/memberships/{organizationId}
//     { organizationId, role ('siteManager'|'foreman'|'worker'),
//       workerType?, trade?, siteIds?, supervisorUid?,
//       status ('active'|'suspended'), approvedAt, approvedBy,
//       createdAt, updatedAt }
//
// This replaces an earlier single nullable `organizationId` field (plus
// `platformRole`/`workerType`/`siteIds` living directly on the profile),
// which could only represent one organization per person. In practice: a
// Site Manager creates/operates several organizations at once; a Foreman is
// placed into an organization by a Site Manager and can be placed into more
// than one; a Worker is placed into an organization (scoped to a Foreman's
// site) by that Foreman. Each of those is a membership document, so a
// person can hold several simultaneously, each with its own role and its
// own independent `active`/`suspended` status.
//
// The top-level profile stays org-less on purpose: a self-registered user
// has no organization yet — there is no `organizations/{orgId}` path, let
// alone a `.../memberships/{orgId}` path, to create anything under at
// registration time. `accountStatus` (pending/active/suspended/rejected) is
// the single authoritative ACCOUNT-level state field (there is deliberately
// no second top-level `active` boolean); it is assigned once, at a person's
// first-ever approval, and gates sign-in/app access globally regardless of
// how many organizations they later join. Membership `status` is a
// SEPARATE, per-organization concept: it lets a reviewer suspend a person's
// access to one organization without touching `accountStatus` or any other
// membership they hold.
//
// `platformRole` (PROJECT_CONTEXT.md §12/§16 — `admin` or absent; a
// person's per-organization role now lives on their membership doc instead)
// is assigned during account review. These rules give `platformRole` no
// WRITE power of its own for any role, ever — it is consumed exclusively by
// Cloud Functions callables (`listPendingApprovals` / `approvePendingAccount`
// / `rejectPendingAccount` / `listOrganizationUsers` / `suspendActiveAccount`
// / `reinstateSuspendedAccount` / `suspendMembership` /
// `reinstateMembership` / `addOrganizationMembership` / `createOrganization`
// / `updateOrganization` / `createProject` / `updateProject` / `createSite`
// / `updateSite`), which run on the Admin SDK and check it server-side.
// Deliberately there is no second, rules-language implementation of any of
// those authorization decisions: one authorization path per privileged
// action is one thing to keep correct.
//
// The one READ exception: `isAdmin()` below reads the caller's own
// `platformRole` to grant an Admin a read of every organization, project and
// site rather than only their own (they belong to none — see
// AppRole.isPlatformLevel in the Flutter source). A read grant cannot be
// used to escalate anything; it is not a write path, and it changes nothing
// about the write rules above.
//
// Admin is platform-level, not organization-scoped, and is never a reachable
// outcome of registration or of the review callables — only
// `scripts/approve_account.ts`'s `bootstrap-admin` command, run by an
// operator holding service-account credentials, can grant it. These rules
// treat it exactly like every other role value for writes: still absent
// from every client create/update, still Admin-SDK-only. Admin holds no
// membership documents at all — it is platform-wide by construction, not by
// belonging to every organization.
//
// `platformRole` is Admin-SDK-writable only — it appears in the
// creation-blocked and update-blocked field lists below, so a reviewer
// cannot grant themselves or anyone else Admin through a direct write, only
// through the operator script. The former per-org fields
// (`organizationId`/`workerType`/`trade`/`siteIds`/`supervisorUid`) no
// longer exist on `users/{uid}` at all — new code never writes them there —
// and the membership subcollection below carries the same deny-by-default
// posture: `allow write: if false`, Admin-SDK-only via the callables
// (which independently refuse self-action and role-escalation — see
// `approval_callable.ts`).
//
// `siteIds` — a worker's granted site access — now lives on the worker's
// membership document for that organization, Admin-SDK-writable only via
// `assignWorkerToSite`/`removeWorkerFromSite`
// (`site_assignment_callable.ts`), which in turn is the prerequisite
// `assignWorkerToActivity` (`activity_assignment_callable.ts`) checks before
// letting a worker be assigned to an activity at that site.
//
// SITE- AND ACTIVITY-SCOPED AUTHORIZATION IS NOT IMPLEMENTED YET. A
// siteManager's role grants organization-wide authority only where
// PROJECT_CONTEXT.md §16 says so without qualification; where it requires
// site assignment, that authority is withheld until site assignment records
// exist. Operational collections remain readable by active members of the
// owning organization and writable by NO client at all in the meantime. It
// is deliberate that this is more restrictive than the eventual model —
// under-permitting is recoverable, over-permitting is a breach.
//
// `organizations/{orgId}/projects/{projectId}` and
// `organizations/{orgId}/sites/{siteId}` (FIRESTORE_DATA_MODEL.md §3) are the
// Organization -> Project -> Site foundation: read requires organization
// membership (or Admin), write is Admin-SDK-only via
// `organization_callable.ts`, which enforces the relationship
// `site.organizationId == project.organizationId` server-side before ever
// writing a site. Worker assignment to a site and activity records are a
// later stage, not implemented here.
service cloud.firestore {
  match /databases/{database}/documents {

    // ---- Identity helpers ----

    function isAuthenticated() {
      return request.auth != null;
    }

    function isSelf(uid) {
      return isAuthenticated() && request.auth.uid == uid;
    }

    // The caller's own profile document. Top-level, so it is addressable by
    // uid alone without knowing an organization.
    function currentUserProfile() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    function hasProfile() {
      return isAuthenticated()
        && exists(/databases/$(database)/documents/users/$(request.auth.uid));
    }

    // The real enforcement of "only approved users get in". A pending,
    // suspended or rejected account loses all operational access even though
    // Firebase Auth still considers it signed in; the client's
    // AuthStatus.pending/suspended/rejected are UX only.
    function isActiveUser() {
      return hasProfile() && currentUserProfile().accountStatus == 'active';
    }

    // The caller's own membership document for a given organization.
    // Membership is the source of truth for "does this person belong to
    // this organization, and with what status/role" — there is no longer a
    // scalar `organizationId` field on the profile to compare against.
    //
    // Calling this when no such membership document exists is a rules
    // evaluation ERROR (get().data on an absent document), not simply
    // `false` — the rules language does not guarantee `&&`/`||` short-circuit
    // order around `get`/`exists` calls, so callers MUST NOT rely on
    // `hasMembership(organizationId) && membershipDoc(organizationId)...`
    // to protect this. Every caller below therefore only ever invokes this
    // from inside a `belongsToOrganization`/`membershipRole` style helper
    // that is guaranteed by construction never to be reached for a
    // nonexistent membership — see those functions.
    function membershipDoc(organizationId) {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)/memberships/$(organizationId)).data;
    }

    function hasMembership(organizationId) {
      return isAuthenticated()
        && exists(/databases/$(database)/documents/users/$(request.auth.uid)/memberships/$(organizationId));
    }

    // An active user with an ACTIVE membership in this organization. A
    // membership can exist but be `suspended` — that no longer counts as
    // belonging, mirroring how `accountStatus != active` no longer counts
    // as an active account.
    //
    // Written as a single ternary rather than `hasMembership(...) &&
    // membershipDoc(...).status == 'active'` so that when no membership
    // document exists, evaluation stops at `false` inside the ternary's own
    // branch selection rather than ever calling `membershipDoc` (whose
    // `get(...).data` would error on an absent document) — the rules
    // language's `&&`/`||` operators do not guarantee that a false first
    // operand skips evaluating a `get`/`exists`-calling second operand, but
    // a ternary's untaken branch is never evaluated.
    function belongsToOrganization(organizationId) {
      return isActiveUser()
        && (hasMembership(organizationId)
          ? membershipDoc(organizationId).status == 'active'
          : false);
    }

    // The platform-level role, read the same way every other authorization
    // check here reads the caller's own profile. This is a READ grant only:
    // it is used below to let an Admin read every organization/project/site
    // rather than just their own (they have none of their own — see
    // AppRole.isPlatformLevel in the Flutter source), and confers no write
    // power anywhere in this file. Creating and editing these records
    // remains Admin-SDK-only via `organization_callable.ts`'s
    // `requireAdmin`/`requireOrganizationScopedManager`, exactly like
    // account review — one authorization path, not a second rules-language
    // implementation that could drift from it.
    function isAdmin() {
      return isActiveUser() && currentUserProfile().platformRole == 'admin';
    }

    // ---- User profile field protection ----

    // Fields no client may ever set at creation. Their absence is what makes
    // "registration grants no privileges" structural: a registering client
    // literally cannot name an organization, an approval, a role, a worker
    // type, or a status other than pending.
    // `organizationId`, `workerType`, `trade`, `siteIds` and `supervisorUid`
    // no longer exist on `users/{uid}` under the new model — they moved to
    // `users/{uid}/memberships/{organizationId}` — so they are removed from
    // this list. `platformRole` remains: Admin's platformRole is still
    // Admin-SDK-only, never client-writable, and still lives on the
    // top-level profile.
    function registrationOmitsPrivilegedFields() {
      return !request.resource.data.keys().hasAny([
        'approvedAt', 'approvedBy', 'platformRole', 'activityIds', 'active'
      ]);
    }

    // A self-registration document must be exactly this shape, for this uid,
    // with status forced to pending.
    function isValidSelfRegistration(uid) {
      return isSelf(uid)
        && registrationOmitsPrivilegedFields()
        && request.resource.data.keys().hasOnly([
          'uid', 'name', 'email', 'phone', 'accountStatus',
          'createdAt', 'updatedAt'
        ])
        && request.resource.data.uid == uid
        && request.resource.data.accountStatus == 'pending'
        && request.resource.data.name is string
        && request.resource.data.name.size() > 0
        && request.resource.data.email is string
        // Binding the document's email to the verified token email stops a
        // user from registering a profile under somebody else's identity.
        && request.resource.data.email.lower() == request.auth.token.email.lower()
        && request.resource.data.createdAt == request.time
        && request.resource.data.updatedAt == request.time;
    }

    // Fields no client may ever change on an existing profile. Approval,
    // organization assignment, role assignment, worker-type assignment and
    // status transitions are Admin SDK operations only (Cloud Functions
    // bypass these rules), so a client can never approve itself, move itself
    // into an organization, change its own role, un-suspend itself, or forge
    // an audit timestamp.
    //
    // `platformRole` remains in this list for the same reason as always: it
    // is granted only through the operator script, never a client write, so
    // a reviewer cannot escalate their own account to Admin. The former
    // per-org fields (`organizationId`/`workerType`/`trade`/`siteIds`/
    // `supervisorUid`) are removed from this list because they no longer
    // exist on `users/{uid}` at all under the new model — that authority
    // now lives entirely on `users/{uid}/memberships/{organizationId}`,
    // which has its own `allow write: if false` below (Admin-SDK-only via
    // the approval/assignment callables, which independently refuse a
    // reviewer acting on their own account).
    function touchesProtectedFields() {
      return request.resource.data.diff(resource.data).affectedKeys()
        .hasAny(['accountStatus', 'approvedAt', 'approvedBy',
                 'uid', 'email', 'createdAt', 'platformRole']);
    }

    // A user may edit only these fields on their own profile.
    function onlySelfEditableFields() {
      return request.resource.data.diff(resource.data).affectedKeys()
        .hasOnly(['name', 'phone', 'updatedAt']);
    }

    // ---- Deny everything by default ----
    match /{document=**} {
      allow read, write: if false;
    }

    // ---- Collection-group rule for .../activities/{activityId}/assignments/{uid} ----
    // Required IN ADDITION to that subcollection's own PATH-scoped `match`
    // block further below (under `organizations/{organizationId}/
    // activities/{activityId}`) — that block alone is NOT enough for
    // `ActivityAssignmentRepository.watchAssignmentsForWorker`'s
    // `collectionGroup('assignments')` query. A collection-group query has
    // no fixed path prefix for Firestore to bind `organizationId` from, so
    // a rule that reads `organizationId` off the PATH (as the nested block
    // does, via the enclosing `match /organizations/{organizationId}`)
    // cannot be proven safe for ANY collection-group query over
    // `assignments` — Firestore must verify the rule against every
    // possible path the collection id could appear under, and a
    // path-bound variable is meaningless without a fixed path. This
    // surfaced as `permission-denied` for every role, but only once real
    // `assignments` documents existed to make `watchAssignmentsForWorker`
    // actually match something — an empty result set is (trivially, and
    // misleadingly) unaffected by this whole class of failure.
    //
    // The fix: a SEPARATE rule, matched by `{path=**}` (any prefix) so it
    // applies regardless of the query's path shape, checking
    // `resource.data.organizationId` — a FIELD, written by
    // `assignWorkerToActivity`/`removeWorkerFromActivity`
    // (`activity_assignment_callable.ts`) to always equal the path's own
    // `organizationId` — instead of a path segment. This is exactly the
    // pattern Firestore's own collection-group rules documentation
    // prescribes: "store the field, and use `resource.data`, never the
    // path" for a collection-group match. `belongsToOrganization` and
    // `isAdmin` are unaffected — both already read the CALLER's own
    // profile/membership, never touching this document's path or data.
    match /{path=**}/assignments/{uid} {
      allow read: if belongsToOrganization(resource.data.organizationId)
        || isAdmin();
      allow write: if false;
    }

    // ---- users/{uid} — identity documents ----
    match /users/{userId} {
      // Read: your own profile only.
      //
      // Note there is still no reviewer read case here, even though `role`
      // now exists. The in-app approvals screen does NOT read other users'
      // documents directly: it calls the `listPendingApprovals` callable,
      // which runs on the Admin SDK (and so bypasses these rules) after
      // checking the caller's role server-side. Keeping the client's direct
      // read surface at "your own document, and nothing else" means there is
      // exactly one place — the callable — where reviewer authorization is
      // decided, rather than two implementations of the same check that
      // could drift apart.
      //
      // Unauthenticated reads are denied by isSelf().
      allow read: if isSelf(userId);

      // Create: self-registration, and nothing else. The document id must be
      // the caller's own uid, so a user cannot create a profile for anyone
      // else, and the payload is pinned to a pending, org-less shape.
      allow create: if isValidSelfRegistration(userId);

      // Update: name and phone on your own profile.
      //
      // Note this requires only isSelf(), not isActiveUser(): a pending user
      // must be able to correct a typo in their own name or phone while
      // waiting for review. That is safe precisely because the field
      // allow-list excludes everything that carries authority. A suspended
      // or rejected user can likewise still edit these harmless fields but
      // gains no access from doing so.
      allow update: if isSelf(userId)
        && onlySelfEditableFields()
        && !touchesProtectedFields()
        && request.resource.data.updatedAt == request.time;

      // Profiles are retained so historical safety records keep referring to
      // a real user. Rejection is a status, not a deletion.
      allow delete: if false;

      // ---- users/{userId}/memberships/{organizationId} ----
      // One document per organization a person belongs to — see the header
      // comment for the full shape. Read: the owner reads their own
      // memberships (the client needs this to know which organizations to
      // operate in and to show role/status per org), or Admin, matching
      // Admin's platform-wide oversight everywhere else in this file. Write
      // is Admin-SDK-only, exactly like every other privileged field here:
      // provisioned exclusively through `approvePendingAccount` (first
      // membership, alongside `accountStatus: active`),
      // `addOrganizationMembership` (an additional membership for an
      // already-active user), `createOrganization` (the creating Site
      // Manager's own membership), and `suspendMembership`/
      // `reinstateMembership` (toggling `status` only) — see
      // `approval_callable.ts`/`organization_callable.ts`.
      match /memberships/{organizationId} {
        allow read: if isSelf(userId) || isAdmin();
        allow write: if false;
      }
    }

    // ---- organizations/{organizationId} ----
    match /organizations/{organizationId} {
      // A member of this organization can read it; a Admin
      // can read every organization, matching their platform-wide review
      // authority elsewhere (see `requireApprover` in
      // `approval_callable.ts`, which lets them approve into any
      // organization).
      allow read: if belongsToOrganization(organizationId) || isAdmin();
      // Organizations are provisioned exclusively through
      // `createOrganization`/`updateOrganization` (Admin SDK) — see
      // `organization_callable.ts`.
      allow write: if false;

      // ---- organizations/{organizationId}/projects/{projectId} ----
      match /projects/{projectId} {
        allow read: if belongsToOrganization(organizationId) || isAdmin();
        // Provisioned exclusively through `createProject`/`updateProject`.
        allow write: if false;
      }

      // ---- organizations/{organizationId}/sites/{siteId} ----
      // Flat under the organization rather than nested under `projects`,
      // matching FIRESTORE_DATA_MODEL.md §3: a site's project is a
      // `projectId` field, not a path segment.
      //
      // PHASE 3 (authorization matrix): Site Manager/Admin see every site
      // in the organization ("View projects/sites: Site Manager = all");
      // a Foreman or Worker sees only a site that is in their OWN
      // membership `siteIds` ("assigned scope only") — no extra `get()`
      // beyond `membershipDoc` (already read for `belongsToOrganization`),
      // since `siteIds` already lives on that same membership document.
      match /sites/{siteId} {
        // `get`/`list` are split here — NOT one `allow read` — because
        // "rules are not filters": Cloud Firestore proves a rule safe for a
        // LIST query using only the query's own constraints, evaluating
        // every `||` branch of the rule against the query shape. A branch
        // that references `resource.data`/the document id (the
        // Foreman/Worker `siteIds.hasAny([siteId])` check below) can never
        // be proven safe against `SiteRepository.watchAll()` (no
        // `.where()` at all), so Firestore rejects that ENTIRE query for
        // EVERY caller — including an Admin/siteManager who'd trivially
        // satisfy an earlier, query-independent branch — because it cannot
        // selectively ignore an unprovable branch just because another one
        // would have sufficed. This previously surfaced as
        // `permission-denied` for an Admin/Site Manager account, on
        // `activities`' identical shape, calling
        // `SafetyComplianceRepository.buildSiteCompliance` — a screen no
        // Foreman/Worker even reaches for this particular project's
        // dataset — because the RULE TEXT poisoned the query regardless of
        // who actually issued it.
        //
        // `allow get` (single-document reads, always provable) keeps the
        // full site-scoped grant. `allow list` (collection queries) is
        // deliberately narrower — ONLY the query-independent conditions
        // (`isAdmin()`, `role == 'siteManager'`) — which is exactly what
        // [SiteRepository.watchAll] needs (Admin/Site Manager only) and
        // matches how the client actually queries: a Foreman/Worker never
        // calls `watchAll()`, only [SiteRepository.watchByIds] (a
        // `documentId in [...]` query, itself safely provable — but kept
        // out of `list` here too, since Firestore's static prover cannot
        // special-case one query shape within a single rule expression;
        // the client already scopes Foreman/Worker requests correctly, and
        // per-document `get()` reads remain available to them via
        // `SiteRepository.watchById` if ever needed).
        allow get: if isAdmin()
          || (belongsToOrganization(organizationId)
              && membershipDoc(organizationId).role == 'siteManager')
          || (belongsToOrganization(organizationId)
              && membershipDoc(organizationId).siteIds is list
              && membershipDoc(organizationId).siteIds.hasAny([siteId]));
        allow list: if isAdmin()
          || (belongsToOrganization(organizationId)
              && membershipDoc(organizationId).role == 'siteManager');
        // Provisioned exclusively through `createSite`/`updateSite`, which
        // additionally verifies server-side that the named project's own
        // `organizationId` matches this path's `organizationId` before
        // writing — see that callable's doc comment.
        allow write: if false;
      }

      // ---- organizations/{organizationId}/activities/{activityId} ----
      // Flat under the organization, matching `sites/{siteId}`: an
      // activity's project and site are `projectId`/`siteId` fields, not
      // path segments.
      //
      // PHASE 3 (authorization matrix): scoped the same way as `sites`
      // above — Site Manager/Admin see every activity in the organization;
      // a Foreman or Worker sees only an activity whose own `siteId` is in
      // their membership `siteIds`.
      match /activities/{activityId} {
        // `get`/`list` split — see `sites/{siteId}`'s own doc comment for
        // why: "rules are not filters," so a rule branch that depends on
        // `resource.data` (the Foreman/Worker site-scope check here) can
        // poison an ENTIRE list query for EVERY caller, including one who'd
        // trivially satisfy `isAdmin()`/`role == 'siteManager'`, the moment
        // Firestore cannot statically prove that branch safe for the query
        // shape — which is exactly what was surfacing as
        // `permission-denied` for an ADMIN/Site Manager account on
        // `ActivityRepository.watchBySite(siteId)` (a `where('siteId',
        // ==, ...)` query — provably constrained on its face, but
        // `hasAny()` over that constrained value is apparently not one of
        // the forms Firestore's static prover simplifies away, unlike a
        // plain `==`), even though that account never needed the
        // Foreman-only branch to succeed at all.
        allow get: if isAdmin()
          || (belongsToOrganization(organizationId)
            ? membershipDoc(organizationId).role == 'siteManager'
              || (membershipDoc(organizationId).siteIds is list
                  && membershipDoc(organizationId).siteIds
                      .hasAny([resource.data.siteId]))
            : false);
        allow list: if isAdmin()
          || (belongsToOrganization(organizationId)
              && membershipDoc(organizationId).role == 'siteManager');
        // Provisioned exclusively through `createActivity`/`updateActivity`
        // (`activity_callable.ts`), which additionally verifies server-side
        // that the named site's own `organizationId`/`projectId` match this
        // path's `organizationId` and the given `projectId` before writing.
        allow write: if false;

        // ---- .../activities/{activityId}/assignments/{uid} ----
        // One document per worker assigned to this activity, keyed by uid.
        // Positioned above the operational-collection catch-all below so it
        // is not shadowed, and so the collection-group query used by the
        // worker detail screen's "Assigned Activities" section (which reads
        // across every activity's assignments subcollection at once) is
        // covered by an explicit rule rather than falling through to deny.
        match /assignments/{uid} {
          allow read: if belongsToOrganization(organizationId) || isAdmin();
          // Provisioned exclusively through `assignWorkerToActivity`/
          // `removeWorkerFromActivity` (`activity_assignment_callable.ts`),
          // which re-validates organization membership, site membership and
          // self-assignment server-side before writing.
          allow write: if false;
        }
      }

      // ---- organizations/{organizationId}/safety_learning/{learningId} ----
      // Flat under the organization, matching `activities/{activityId}`.
      match /safety_learning/{learningId} {
        allow read: if belongsToOrganization(organizationId) || isAdmin();
        // Provisioned exclusively through `createSafetyLearning`/
        // `updateSafetyLearning` (`safety_learning_callable.ts`).
        allow write: if false;
      }

      // ---- organizations/{orgId}/safety_learning/{id}/knowledge_check_questions/{qId} ----
      // Deliberately DENIED to every client, unlike the parent document
      // above — a question here carries `correctOptionId`, which a worker
      // must never be able to read directly. The ONLY path a worker ever
      // sees question content through is `getKnowledgeCheckQuestions`
      // (`worker_learning_callable.ts`), which strips `correctOptionId`
      // server-side before responding. Admin authoring goes through
      // `addKnowledgeCheckQuestion`/`updateKnowledgeCheckQuestion`/
      // `removeKnowledgeCheckQuestion` (`safety_learning_callable.ts`).
      // Explicitly `match`ed (rather than left to the catch-all below) so
      // this denial is unambiguous and doesn't depend on the catch-all's
      // exclusion list staying correct.
      match /safety_learning/{learningId}/knowledge_check_questions/{questionId} {
        allow read: if false;
        allow write: if false;
      }

      // ---- organizations/{organizationId}/safety_requirements/{requirementId} ----
      match /safety_requirements/{requirementId} {
        allow read: if belongsToOrganization(organizationId) || isAdmin();
        // Provisioned exclusively through `createSafetyRequirement`/
        // `updateSafetyRequirement` (`safety_learning_callable.ts`), which
        // additionally verifies server-side that every id in
        // `requiredLearningIds` refers to an existing `safety_learning`
        // document in the same organization before writing.
        allow write: if false;
      }

      // ---- organizations/{organizationId}/safety_meeting_points/{id} ----
      // Flat under the organization, matching `safety_learning/{learningId}`.
      match /safety_meeting_points/{meetingPointId} {
        allow read: if belongsToOrganization(organizationId) || isAdmin();
        // Provisioned exclusively through `createSafetyMeetingPoint`/
        // `updateSafetyMeetingPoint`/`activateSafetyMeetingPoint`/
        // `deactivateSafetyMeetingPoint` (`safety_meeting_point_callable.ts`).
        allow write: if false;
      }

      // ---- organizations/{organizationId}/daily_safety_meetings/{id} ----
      // Flat under the organization, matching `safety_meeting_points/{id}`.
      //
      // PHASE 3 (authorization matrix): read is scoped by role, NOT a flat
      // "any org member" grant like most collections in this file —
      // Site Manager/Admin review every meeting org-wide (PROJECT_CONTEXT.md
      // §16), a Foreman reviews only the meetings THEY conducted
      // (`resource.data.foremanId == request.auth.uid`). This mirrors
      // `worker_learning_records`' siteManager carve-out pattern: the
      // caller's own membership document for THIS meeting's organization is
      // checked, not a top-level profile field, since role is
      // per-organization.
      //
      // DASHBOARD (Phase 2): a Worker additionally may read a meeting whose
      // OWN `siteId` is in their own membership's `siteIds` — narrower than
      // the Foreman/siteManager grants above (no write, and the client
      // query narrows further to today's date; this rule only bounds WHICH
      // meetings a worker's query is allowed to touch at all, matching the
      // same `siteIds.hasAny([...])` shape `sites/{siteId}` and
      // `activities/{activityId}` already use for a Foreman). Before this,
      // a Worker had no way to discover today's meeting at their own site
      // (their own participation was visible only via the `attendance`
      // subcollection below, which requires already knowing the
      // `meetingId` — undiscoverable without this grant).
      match /daily_safety_meetings/{meetingId} {
        allow read: if isAdmin()
          || (belongsToOrganization(organizationId)
            ? membershipDoc(organizationId).role == 'siteManager'
              || (membershipDoc(organizationId).role == 'foreman'
                  && resource.data.foremanId == request.auth.uid)
              || (membershipDoc(organizationId).role == 'worker'
                  && membershipDoc(organizationId).siteIds is list
                  && membershipDoc(organizationId).siteIds
                      .hasAny([resource.data.siteId]))
            : false);
        // Provisioned exclusively through `createDailySafetyMeeting`/
        // `updateDailySafetyMeeting`/`completeDailySafetyMeeting`
        // (`daily_safety_meeting_callable.ts`), which additionally verifies
        // server-side that the caller is an active `foreman` with the
        // meeting's own site in their `siteIds`, that the site belongs to
        // the given organization/project, and that every activity/meeting
        // point id named belongs to that site/organization respectively.
        allow write: if false;

        // ---- .../daily_safety_meetings/{meetingId}/attendance/{workerId} ----
        // Read follows the parent meeting's shape (Site Manager/Admin: all;
        // Foreman: only their own meeting's attendance), PLUS a worker may
        // read their OWN attendance record — this is the one place a Worker
        // has any read access into this collection at all, matching
        // PROJECT_CONTEXT.md §16 ("Worker: none" for reviewing meeting
        // summaries broadly, but a worker can still see their own recorded
        // attendance). Provisioned exclusively through
        // `recordMeetingAttendance` (`daily_safety_meeting_callable.ts`),
        // which additionally verifies server-side that the caller is the
        // meeting's own foreman, that the meeting is still `inProgress`,
        // that `workerId` belongs to the meeting's own site, and that
        // `workerId` is never the caller's own uid — a worker cannot mark
        // themselves present.
        match /attendance/{workerId} {
          allow read: if isAdmin()
            || (belongsToOrganization(organizationId)
              ? membershipDoc(organizationId).role == 'siteManager'
                || (membershipDoc(organizationId).role == 'foreman'
                    && get(/databases/$(database)/documents/organizations/$(organizationId)/daily_safety_meetings/$(meetingId)).data.foremanId == request.auth.uid)
                || workerId == request.auth.uid
              : false);
          allow write: if false;
        }

        // ---- .../daily_safety_meetings/{meetingId}/concerns/{concernId} ----
        // Read follows the parent meeting's shape: Site Manager/Admin see
        // every concern; a Foreman sees only concerns on meetings they
        // conducted; a Worker has no read access — a completed meeting's
        // concerns are part of the same permanent record as the meeting
        // itself, so this deliberately does NOT extend the worker
        // self-read carve-out `attendance` above has (a concern is not
        // "this worker's own data" the way their attendance is).
        // Provisioned exclusively through `addMeetingConcern`/
        // `updateMeetingConcern`/`removeMeetingConcern`
        // (`daily_safety_meeting_callable.ts`), which additionally verify
        // server-side that the caller is the meeting's own foreman and that
        // the meeting is still `inProgress` — once `completed`, all three
        // refuse, so a concern can never be silently altered after the
        // meeting closes.
        match /concerns/{concernId} {
          allow read: if isAdmin()
            || (belongsToOrganization(organizationId)
              ? membershipDoc(organizationId).role == 'siteManager'
                || (membershipDoc(organizationId).role == 'foreman'
                    && get(/databases/$(database)/documents/organizations/$(organizationId)/daily_safety_meetings/$(meetingId)).data.foremanId == request.auth.uid)
              : false);
          allow write: if false;
        }

        // ---- .../daily_safety_meetings/{meetingId}/point_notes/{meetingPointId} ----
        // A discussion note per covered meeting point — what was actually
        // explained/discussed, kept deliberately separate from `concerns`
        // (an issue/status record, never discussion context). Read follows
        // `concerns`' exact shape: Site Manager/Admin see every meeting's
        // notes; a Foreman sees only notes on meetings they conducted; a
        // Worker has no read access — a note is not "the worker's own
        // data" the way attendance is, same reasoning already applied to
        // concerns. Provisioned exclusively through `setMeetingPointNote`/
        // `removeMeetingPointNote` (`daily_safety_meeting_callable.ts`),
        // which additionally verify server-side that the caller is the
        // meeting's own foreman and that the meeting is still
        // `inProgress` — once `completed`, both refuse.
        match /point_notes/{meetingPointId} {
          allow read: if isAdmin()
            || (belongsToOrganization(organizationId)
              ? membershipDoc(organizationId).role == 'siteManager'
                || (membershipDoc(organizationId).role == 'foreman'
                    && get(/databases/$(database)/documents/organizations/$(organizationId)/daily_safety_meetings/$(meetingId)).data.foremanId == request.auth.uid)
              : false);
          allow write: if false;
        }

        // ---- .../daily_safety_meetings/{meetingId}/foreman_points/{pointId} ----
        // Points the Foreman typed themself (title, what was discussed, an
        // optional activity), on this meeting only — never the library.
        // Read follows `point_notes`' exact shape. Written only through
        // `saveMeetingForemanPoint`/`removeMeetingForemanPoint`
        // (`daily_safety_meeting_callable.ts`).
        match /foreman_points/{pointId} {
          allow read: if isAdmin()
            || (belongsToOrganization(organizationId)
              ? membershipDoc(organizationId).role == 'siteManager'
                || (membershipDoc(organizationId).role == 'foreman'
                    && get(/databases/$(database)/documents/organizations/$(organizationId)/daily_safety_meetings/$(meetingId)).data.foremanId == request.auth.uid)
              : false);
          allow write: if false;
        }

        // ---- .../daily_safety_meetings/{meetingId}/evidence/{evidenceId} ----
        // Supporting proof (a photo of the foreman's handwritten toolbox-
        // talk book, a sign-in sheet, a briefing/site photo, or another
        // document) that the meeting happened as recorded. Read follows
        // `concerns`'/`point_notes`' exact shape: Site Manager/Admin see
        // every meeting's evidence; a Foreman sees only evidence on
        // meetings they conducted; a Worker has no read access. Provisioned
        // exclusively through `addMeetingEvidence`/`removeMeetingEvidence`
        // (`daily_safety_meeting_callable.ts`) — this metadata write path
        // is separate from the actual file bytes, which the client uploads
        // directly to Cloud Storage (see `storage.rules`) before calling
        // `addMeetingEvidence`. UNLIKE every other subcollection here,
        // `addMeetingEvidence` deliberately accepts a COMPLETED meeting (a
        // foreman may not have the physical evidence ready the moment they
        // complete the meeting) — see that callable's own doc comment for
        // why. `removeMeetingEvidence` is still `inProgress`-only, matching
        // `corrective_actions`' "no delete once permanent" rule.
        match /evidence/{evidenceId} {
          allow read: if isAdmin()
            || (belongsToOrganization(organizationId)
              ? membershipDoc(organizationId).role == 'siteManager'
                || (membershipDoc(organizationId).role == 'foreman'
                    && get(/databases/$(database)/documents/organizations/$(organizationId)/daily_safety_meetings/$(meetingId)).data.foremanId == request.auth.uid)
              : false);
          allow write: if false;
        }
      }

      // ---- organizations/{organizationId}/hazards/{hazardId} ----
      // Flat under the organization (a sibling of `corrective_actions`), so
      // an authorized reviewer's Hazards screen can query every hazard
      // across every site in one collection, and a worker's own "My
      // Reports" view is a query narrowed to `reportedByUid`, not a
      // different collection. Read follows the same org-member-or-System-
      // Administrator shape as `corrective_actions`: a hazard is part of
      // the permanent safety record, visible to any active org member, not
      // personal data scoped to the reporter alone.
      match /hazards/{hazardId} {
        allow read: if belongsToOrganization(organizationId) || isAdmin();
        // Provisioned exclusively through `createHazard`/`acknowledgeHazard`/
        // `linkHazardCorrectiveAction`/`closeHazard` (`hazard_callable.ts`).
        // `createHazard` additionally verifies server-side that the caller
        // is an active member of this organization with the hazard's own
        // `siteId` in their `siteIds`, and derives `projectId` from the
        // site document rather than trusting it from the request.
        // `acknowledgeHazard`/`linkHazardCorrectiveAction`/`closeHazard`
        // additionally verify server-side that the caller holds an
        // authorized reviewer role (`admin`/`siteManager` — see
        // `account_approval.ts`'s `canReviewPendingAccounts`) within the
        // hazard's own organization.
        // There is no delete callable and this rule denies delete too: a
        // hazard, like a corrective action, is a permanent part of the
        // safety record once created.
        allow write: if false;
      }

      // ---- organizations/{organizationId}/inspection_templates/{id} ----
      // ---- organizations/{organizationId}/inspections/{id} ----
      // Site inspections (daily site inspection, weekly HSE walk-down) and
      // their checklists — `inspection_callable.ts`. Read by the people who
      // inspect and review (Admin/Site Manager/Foreman) and the System
      // Administrator; every write goes through the callables. Deficiencies
      // found become `hazards` (readable as usual).
      match /inspection_templates/{templateId} {
        allow read: if isAdmin()
          || (belongsToOrganization(organizationId)
            && membershipDoc(organizationId).role in
              ['admin', 'siteManager', 'foreman']);
        allow write: if false;
      }
      match /inspections/{inspectionId} {
        allow read: if isAdmin()
          || (belongsToOrganization(organizationId)
            && membershipDoc(organizationId).role in
              ['admin', 'siteManager', 'foreman']);
        allow write: if false;
      }

      // ---- organizations/{organizationId}/safety_meetings/{id} ----
      // Weekly employee and monthly supervisory safety meetings —
      // `safety_meeting_callable.ts`. Read by the roles that run them
      // (Admin/Site Manager/Foreman) and the System Administrator; written
      // only by the callable, and permanent once recorded.
      match /safety_meetings/{meetingId} {
        allow read: if isAdmin()
          || (belongsToOrganization(organizationId)
            && membershipDoc(organizationId).role in
              ['admin', 'siteManager', 'foreman']);
        allow write: if false;
      }

      // ---- organizations/{organizationId}/incidents/{incidentId} ----
      // Flat under the organization, like `hazards`. Unlike a hazard, an
      // incident can name an injured person and describe an injury, so it
      // is NOT readable by every org member: only the reporter themselves,
      // a reviewer role (`admin`/`siteManager`/`foreman` — the same set
      // `incident_callable.ts`'s `requireOrganizationScopedReviewer`
      // accepts) in this organization, or the System Administrator. A
      // worker's "My Incidents" query must therefore be constrained to
      // `reportedByUid == request.auth.uid` for the rule to admit it.
      match /incidents/{incidentId} {
        allow read: if isAdmin()
          || (belongsToOrganization(organizationId)
            && (resource.data.reportedByUid == request.auth.uid
              || membershipDoc(organizationId).role in
                ['admin', 'siteManager', 'foreman']));
        // Provisioned exclusively through `createIncident`/
        // `startIncidentInvestigation`/`linkIncidentCorrectiveAction`/
        // `closeIncident` (`incident_callable.ts`). Never deletable.
        allow write: if false;
      }

      // ---- organizations/{organizationId}/corrective_actions/{id} ----
      // Flat under the organization (a sibling of `daily_safety_meetings`,
      // not a subcollection of one) — a corrective action's meeting/concern
      // are `meetingId`/`concernId` fields, not path segments, so an
      // authorized supervisor/manager's Corrective Actions list can query
      // every action across every site and meeting in one collection. Read
      // follows the same org-member-or-System-Administrator shape as
      // `daily_safety_meetings`: a corrective action is part of the
      // permanent safety record, not personal data scoped to one user.
      match /corrective_actions/{actionId} {
        allow read: if belongsToOrganization(organizationId) || isAdmin();
        // Provisioned exclusively through `createCorrectiveAction`
        // (`corrective_action_callable.ts`), which accepts EITHER a
        // `meetingId` (verifying server-side that the caller is that
        // meeting's own foreman on an `inProgress` meeting, and that any
        // named `concernId` belongs to that meeting) OR a `hazardId`
        // (verifying server-side that the caller holds an authorized
        // reviewer role and that the named hazard is not already closed or
        // already linked — the same path `hazard_callable.ts`'s
        // `linkHazardCorrectiveAction` reaches through the shared
        // `createCorrectiveActionForHazard` implementation) — never both.
        // In either case, `assignedTo` must be an active member of this
        // organization, and never the caller's own uid — a worker cannot
        // assign a corrective action to themselves.
        // `submitCorrectiveActionForReview` lets the action's own
        // `assignedTo` move `open`/`inProgress` to `submittedForReview` —
        // "I've done the work." `updateCorrectiveActionStatus` transitions
        // every OTHER status afterward, restricted to the same reviewer
        // roles (`admin`/`siteManager`, plus `foreman` for their own site)
        // already trusted to review pending accounts — see
        // `account_approval.ts`'s `canReviewPendingAccounts`; `completed` is
        // only reachable from `submittedForReview` — "a reviewer verified
        // that claim." There is
        // no delete callable and this rule denies delete too: a corrective
        // action, like a completed meeting's concerns, is a permanent part
        // of the safety record once created.
        allow write: if false;
      }

      // ---- organizations/{organizationId}/safety_alerts/{alertId} ----
      // Flat under the organization (a sibling of `corrective_actions`), so
      // an authorized user's Safety Alerts screen can query every alert
      // across every site in one collection, and a worker/foreman's own
      // site view is a query narrowed to `siteId`, not a different
      // collection. Read follows the same org-member-or-System-
      // Administrator shape as `corrective_actions`: a safety alert is part
      // of the permanent safety record, visible to any active org member —
      // "Workers/foremen can view alerts applicable to their organization/
      // site" from this feature's task description.
      match /safety_alerts/{alertId} {
        allow read: if belongsToOrganization(organizationId) || isAdmin();
        // Provisioned exclusively through `createSafetyAlert`/
        // `acknowledgeSafetyAlert`/`resolveSafetyAlert`
        // (`safety_alert_callable.ts`), which additionally verify
        // server-side that the caller holds an authorized reviewer role
        // (`admin`/`siteManager` — see `account_approval.ts`'s
        // `canReviewPendingAccounts`) within the alert's own organization,
        // and that the named site belongs to the given organization/
        // project. There is no delete callable and this rule denies delete
        // too: a safety alert, like a corrective action, is a permanent
        // part of the safety record once created.
        allow write: if false;
      }

      // ---- organizations/{organizationId}/notifications/{id} ----
      // Unlike `safety_alerts`/`corrective_actions`, this one is scoped
      // narrower than "any org member" — a notification is personal data
      // addressed to exactly one `recipientUid`, mirroring
      // `worker_learning_records`'s own "owning worker only" read boundary
      // below. Read is limited to the notification's OWN `recipientUid` or
      // an Admin — deliberately NOT any org member, and deliberately NOT
      // even a siteManager (unlike `worker_learning_records`'s
      // compliance-viewing carve-out), since this stage's task description
      // grants nobody but the recipient themself visibility into their own
      // notifications.
      match /notifications/{notificationId} {
        allow read: if isAdmin()
          || (belongsToOrganization(organizationId) && resource.data.recipientUid == request.auth.uid);
        // Provisioned exclusively server-side: `createNotification`
        // (`notification_callable.ts`) is a plain internal function, never
        // an `onCall` callable and never exported from `index.ts`, so no
        // client can create a notification under any circumstance.
        // `markNotificationRead`/`markAllNotificationsRead` transition
        // `isRead`/`readAt` afterward, both re-deriving the acting user from
        // `request.auth.uid` alone and refusing unless
        // `notification.recipientUid` matches — a user can only ever mark
        // their OWN notifications read. There is no delete callable and
        // this rule denies delete too.
        allow write: if false;
      }

      // ---- organizations/{organizationId}/worker_learning_records/{recordId} ----
      // Unlike every other operational collection so far, this one is
      // scoped narrower than "any org member" — a learning record is
      // personal. Read is limited to the OWNING WORKER
      // (`resource.data.workerUid == request.auth.uid`), a `siteManager` of
      // this organization, or an Admin. `foreman` is deliberately NOT
      // granted broader read access here than an ordinary org member gets
      // elsewhere: compliance-viewing across the whole organization is a
      // `siteManager`/`admin` responsibility (PROJECT_CONTEXT.md §12/§16),
      // not a Foreman one — a Foreman's visibility into their own crew's
      // training is provided by `getCrewLearningRecords`
      // (`worker_learning_callable.ts`) instead, an Admin-SDK callable that
      // re-derives and enforces the Foreman's own site scope server-side,
      // never trusting a client-supplied worker list.
      // ---- organizations/{organizationId}/pre_start_checks/{uid}_{date} ----
      // A worker's Daily Pre-Start Check (GO / GO corrected / STOP). Read:
      // the worker themselves; a Foreman whose own membership includes the
      // check's site; any Site Manager of the organization; an Admin.
      // Provisioned exclusively through `submitPreStartCheck`
      // (`pre_start_check_callable.ts`), which takes no workerUid argument
      // and computes the outcome server-side — a check, once submitted, is
      // a permanent safety record, so no client may write or delete one.
      match /pre_start_checks/{checkId} {
        allow read: if isAdmin()
          || (belongsToOrganization(organizationId)
            ? resource.data.workerUid == request.auth.uid
              || membershipDoc(organizationId).role == 'siteManager'
              || (membershipDoc(organizationId).role == 'foreman'
                  && membershipDoc(organizationId).siteIds is list
                  && membershipDoc(organizationId).siteIds
                      .hasAny([resource.data.siteId]))
            : false);
        allow write: if false;
      }

      match /worker_learning_records/{recordId} {
        // The siteManager carve-out below checks the CALLER's own
        // membership document for THIS record's organization, not a
        // top-level profile field: role is per-organization now, so
        // "is this caller a siteManager" only means something with respect
        // to a specific organization, and this record's own organizationId
        // (the path segment) is that organization.
        allow read: if isAdmin()
          || (belongsToOrganization(organizationId) && resource.data.workerUid == request.auth.uid)
          || (belongsToOrganization(organizationId)
            ? membershipDoc(organizationId).role == 'siteManager'
            : false);
        // Provisioned exclusively through `getMyRequiredLearning`/
        // `startLearning`/`completeLearning` (`worker_learning_callable.ts`),
        // none of which accept a workerUid argument — every one derives the
        // acting worker from the caller's own auth token server-side. This
        // is what makes "a worker can only ever write their own record"
        // structural rather than a rules-language self-check that could be
        // bypassed by a modified client; the callables are the only write
        // path regardless.
        allow write: if false;
      }

      // Every other operational collection. Read requires active
      // membership of this organization; writes await the RBAC stage (see
      // the header note) and are denied to every client until the role and
      // site/activity assignment model exists to authorize them properly.
      //
      // BUG FIX: Firestore security rules evaluate every `match` block whose
      // path matches and OR their `allow` conditions together — an earlier,
      // narrower `match` (e.g. `notifications`, `worker_learning_records`,
      // `sites`, `activities`, or `daily_safety_meetings` above) does NOT
      // shadow this later wildcard. Without excluding those collection names
      // here explicitly, this catch-all silently widened their read access
      // back to "any org member," defeating the narrower recipient-only /
      // owner-or-siteManager-only / site-scoped / own-meeting-only scoping
      // those blocks intentionally enforce. `operationalCollection` is
      // therefore checked against each name and denied here — their own
      // `match` blocks above remain the sole source of read authorization
      // for them.
      //
      // `daily_safety_meetings` ALSO covers this wildcard matching its own
      // SUBCOLLECTIONS (`attendance`, `concerns`, `point_notes`,
      // `evidence`) via `documentId=**` — e.g.
      // `daily_safety_meetings/{id}/attendance/{workerId}` matches
      // `operationalCollection == 'daily_safety_meetings'` here too, not
      // just the top-level meeting document — so excluding the one name
      // covers every PHASE 3-scoped block in one exclusion. Likewise
      // `activities` covers its own `assignments/{uid}` subcollection —
      // that subcollection is intentionally NOT site-scoped in this pass
      // (see its own doc comment), so excluding `activities` here does not
      // change its behavior, only prevents this catch-all from double
      // granting the PARENT activity document's read.
      //
      // `safety_learning` is excluded for the same reason as `activities`:
      // its own top-level `match` block above already grants the PARENT
      // document's read to any org member (that part is intentional and
      // unchanged), but its `knowledge_check_questions/{questionId}`
      // SUBCOLLECTION has its own explicit `allow read: if false` — Firestore
      // rules OR every matching block's `allow` together, so without this
      // exclusion this catch-all would silently re-grant that denied read
      // (the exact bug this comment already documents for the other
      // exclusions above).
      match /{operationalCollection}/{documentId=**} {
        allow read: if belongsToOrganization(organizationId)
          && operationalCollection != 'notifications'
          && operationalCollection != 'worker_learning_records'
          && operationalCollection != 'pre_start_checks'
          // Each person's daily "Needed today" learning plan — served only
          // through the learning/meeting callables, never read directly.
          && operationalCollection != 'daily_learning_plans'
          && operationalCollection != 'daily_safety_meetings'
          && operationalCollection != 'sites'
          && operationalCollection != 'activities'
          && operationalCollection != 'safety_learning'
          // Incidents can name an injured person — reporter/reviewer-only
          // via their own `match` block above.
          && operationalCollection != 'incidents'
          // Supervisor-only — see their own `match` blocks above.
          && operationalCollection != 'inspection_templates'
          && operationalCollection != 'inspections'
          && operationalCollection != 'safety_meetings';
        allow write: if false;
      }
    }

    // ---- Audit logs: append-only, Cloud-Functions-only writes ----
    // Reads await the RBAC stage: identifying an administrator requires a
    // role field that does not exist yet.
    match /audit_logs/{logId} {
      allow read, write: if false;
    }
  }
}
